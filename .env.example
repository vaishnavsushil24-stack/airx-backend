# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Meta (Facebook) Lead Ads ---
# You choose this string yourself when you set up the webhook in Meta App Dashboard.
# It just has to match on both sides - can be any random string, e.g. airx-meta-2026
META_VERIFY_TOKEN=change-me

# From Facebook Page > Settings > Page access token (or via Graph API Explorer),
# used to fetch full lead details after a leadgen notification arrives.
META_PAGE_ACCESS_TOKEN=

# From your Meta App Dashboard > Settings > Basic > App Secret.
# Used to verify that webhook calls really came from Meta (signature check).
META_APP_SECRET=

# --- Shopify ---
# From dev.shopify.com/dashboard/206208621/apps/413020028929/settings
SHOPIFY_API_KEY=c77030fdb88b79b4ac0b4ed1c245c86a
# Click "Reveal client secret" on that same page and paste it here yourself -
# this is the one value Claude should never see or type, so copy it directly.
SHOPIFY_API_SECRET=
# Your store's .myshopify.com domain (NOT the admin.shopify.com/store/... one).
# Find it in Shopify Admin -> Settings -> Domains (it'll look like
# something.myshopify.com). Likely airx-plus-healthcare-pvt-ltd.myshopify.com
# but please confirm from that page before using it.
SHOPIFY_SHOP=airx-plus-healthcare-pvt-ltd.myshopify.com

# --- AIRX Ops API ---
# Any random string. The AIRX Ops dashboard sends this in an "x-api-key" header
# so random people on the internet can't read/write your leads and orders.
AIRX_API_KEY=change-me-too

# Port the server listens on (Render/Railway set this automatically in production)
PORT=3000
