# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Meta (Facebook) Lead Ads ---
# You choose this string yourself when you set up the webhook in Meta App Dashboard.
# It just has to match on both sides - can be any random string, e.g. airx-meta-2026
META_VERIFY_TOKEN=change-me

# From Facebook Page > Settings > Page access token (or via Graph API Explorer),
# used to fetch full lead details after a leadgen notification arrives.
META_PAGE_ACCESS_TOKEN=

# From your Meta App Dashboard > Settings > Basic > App Secret.
# Used to verify that webhook calls really came from Meta (signature check).
META_APP_SECRET=

# --- Shopify ---
# From dev.shopify.com/dashboard/206208621/apps/413020028929/settings
SHOPIFY_API_KEY=c77030fdb88b79b4ac0b4ed1c245c86a
# Click "Reveal client secret" on that same page and paste it here yourself -
# this is the one value Claude should never see or type, so copy it directly.
SHOPIFY_API_SECRET=
# Your store's .myshopify.com domain (NOT the admin.shopify.com/store/... one).
# Find it in Shopify Admin -> Settings -> Domains (it'll look like
# something.myshopify.com). Likely airx-plus-healthcare-pvt-ltd.myshopify.com
# but please confirm from that page before using it.
SHOPIFY_SHOP=airx-plus-healthcare-pvt-ltd.myshopify.com

# --- AIRX Ops API ---
# Any random string. The AIRX Ops dashboard sends this in an "x-api-key" header
# so random people on the internet can't read/write your leads and orders.
AIRX_API_KEY=change-me-too

# Port the server listens on (Render/Railway set this automatically in production)
PORT=3000

# --- India Post (Bulk Customer API) ---
# Sandbox by default. India Post will give you a production URL after UAT sign-off.
INDIAPOST_BASE_URL=https://test.cept.gov.in

# The login India Post issued you (from integrations.cept@indiapost.gov.in, or the
# approach document if you haven't been issued your own yet). Same rule as Shopify's
# secret - paste this straight into Render, never into chat with Claude.
INDIAPOST_USERNAME=
INDIAPOST_PASSWORD=

# Your Bulk Customer ID and Contract ID (from India Post onboarding). Falls back to
# the shared sandbox test values from the approach doc if left blank - fine for
# testing, but ask India Post to confirm your real ones before going live.
INDIAPOST_BULK_CUSTOMER_ID=
INDIAPOST_CONTRACT_ID=

# REQUIRED before booking will work: the post office ID you drop parcels off at.
# Look it up once: GET /api/indiapost/pincode/<your PIN> (with your x-api-key header)
# and use the office_id where delivery_office_flag is true.
INDIAPOST_DROPOFF_OFFICE_ID=

# Your business's sender details, printed on every India Post label.
INDIAPOST_SENDER_NAME=AIRX Plus Healthcare Pvt Ltd
INDIAPOST_SENDER_ADDRESS=Nimbahera
INDIAPOST_SENDER_CITY=Nimbahera
INDIAPOST_SENDER_STATE=Rajasthan
INDIAPOST_SENDER_PINCODE=
INDIAPOST_SENDER_MOBILE=

# Optional: barcode range India Post assigned you (defaults to the sample range
# from the approach doc - ask India Post for your real range before going live).
INDIAPOST_BARCODE_PREFIX=ET
INDIAPOST_BARCODE_START=
INDIAPOST_BARCODE_END=

# Optional: default parcel weight in grams if an order doesn't specify one.
# Above 500g the article type auto-switches from SP_INLAND_DOC to SP_INLAND_PARCEL.
INDIAPOST_DEFAULT_WEIGHT_GRAMS=300
